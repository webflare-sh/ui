{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "preserve",
    "allowJs": true,
    // To be able to import the preset as @webflare/ui/preset
    "paths": {
      "@webflare/ui/design-preset": ["./packages/preset/src/index.ts"],
      "@webflare/ui/preset": ["./packages/preset/src/index.ts"],
      "@webflare/ui/components": ["./packages/components/src/index.ts"],
      "@webflare/ui/nuxt": ["./packages/nuxt/src/module.ts"],
      "@webflare/ui/*": ["./packages/*/src/index.ts"],
      "@webflare/design-preset": ["./packages/preset/src/index.ts"],
      "@webflare/ui-components": ["./packages/components/src/index.ts"]
    },
    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    // Some stricter flags
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": [
    "packages/*/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "packages/*/dist"
  ]
}
