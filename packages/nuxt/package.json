{
    "name": "@webflare/ui-nuxt",
    "version": "0.1.0",
    "private": true,
    "description": "Nuxt module for the Webflare Vue UI components",
    "license": "MIT",
    "author": "Webflare OÜ",
    "type": "module",
    "homepage": "https://github.com/webflare-sh/ui/tree/master/packages/nuxt#readme",
    "bugs": {
        "url": "https://github.com/webflare-sh/ui/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/webflare-sh/ui.git",
        "directory": "packages/nuxt"
    },
    "keywords": [
        "nuxt",
        "nuxt-module",
        "vue",
        "ui",
        "components",
        "design-system",
        "webflare"
    ],
    "exports": {
        ".": {
            "types": "./dist/types.d.mts",
            "import": "./dist/module.mjs"
        }
    },
    "main": "./dist/module.mjs",
    "typesVersions": {
        "*": {
            ".": [
                "./dist/types.d.mts"
            ]
        }
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "prepack": "nuxt-module-build prepare && nuxt-module-build build",
        "dev": "bun run dev:prepare && cd playground && bun run dev",
        "dev:build": "cd playground && bun run prepare && nuxi build",
        "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
        "lint": "eslint src",
        "test": "vitest run",
        "test:watch": "vitest watch",
        "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
    },
    "dependencies": {
        "@nuxt/kit": "^4.6.3"
    },
    "peerDependencies": {
        "nuxt": "^4.6.3",
        "vue": "^3.5.44",
        "@pandacss/dev": "^2.4.0",
        "reka-ui": "^2.11.0"
    }
}
