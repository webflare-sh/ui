{
  "name": "@webflare/design-preset",
  "version": "0.1.0",
  "private": true,
  "description": "Panda CSS preset with Webflare design tokens",
  "license": "MIT",
  "author": "Webflare OÜ",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/webflare-sh/ui#readme",
  "bugs": {
    "url": "https://github.com/webflare-sh/ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webflare-sh/ui.git",
    "directory": "packages/preset"
  },
  "keywords": [
    "pandacss",
    "design-tokens",
    "design-system",
    "webflare"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "build": "bun run typecheck && tsup src/index.ts --format esm,cjs --dts --clean",
    "watch": "tsup src/index.ts --format esm,cjs --dts --watch"
  },
  "devDependencies": {
    "@pandacss/dev": "^2.4.0",
    "@pandacss/preset-base": "^2.4.0",
    "@pandacss/types": "^2.4.0",
    "tsup": "^9.0.0"
  },
  "peerDependencies": {
    "@pandacss/dev": "^2.4.0",
    "@pandacss/preset-base": "^2.4.0",
    "@pandacss/types": "^2.4.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  }
}
